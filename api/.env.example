# Copy to .env and adjust. Never commit .env.
DATABASE_URL=sqlite:///./learn.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/learn
AUTH_MODE=local            # local = single learner, no login | jwt = accounts with login
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:3000   # your site's address; sent as the contact in API requests (Wikipedia requires one)

# AI (optional). Without a key, courses are built from your syllabus (or the subject's Wikipedia structure)
# with real resources, and lessons are guided outlines. With a key, Claude plans courses and writes full lessons.
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium           # low | medium | high | xhigh | max (higher = better lessons, more cost)
LESSON_WORKERS=2           # lessons written in parallel by "Write the remaining…"

# Optional: ranked YouTube videos (needs a YouTube Data API v3 key)
# YOUTUBE_API_KEY=
